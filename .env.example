# Web port (docker-compose maps the same port on the host; `python -m app` uses it too)
PORT=8290

# Initial admin, created at startup if this username doesn't exist yet.
# Log in with the username (or email). Changing the password here later does NOT
# reset an existing account — change it on the Profile page instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_NAME=ผู้ดูแลระบบ

# Set to true when the site is served over HTTPS (session cookie becomes Secure)
COOKIE_SECURE=false

# Developer API mode (Settings → AI → Developer API)
# GEMINI_API_KEY is used first; GEMINI_LIVE_API_KEY is the fallback.
GEMINI_API_KEY=
GEMINI_LIVE_API_KEY=

# Vertex AI mode needs no env var: upload the service-account JSON in
# Settings, or place it at ./secrets/gcp-service-account.json
